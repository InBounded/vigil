{
  "name": "@vigil/rpc-proxy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir dist",
    "typecheck": "WRANGLER_SEND_METRICS=false wrangler types && tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "WRANGLER_SEND_METRICS=false vitest run",
    "deploy": "WRANGLER_SEND_METRICS=false wrangler deploy"
  },
  "dependencies": {
    "@vigil-sol/core": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "5.0.5",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  }
}
