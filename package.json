{
  "name": "vigil",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.22.2",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "lint": "biome check .",
    "lint:workflows": "tsx scripts/lint-workflows.ts",
    "typecheck": "pnpm -r run typecheck && tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "build": "pnpm -r run build",
    "check": "pnpm lint && pnpm lint:workflows && pnpm typecheck && pnpm build && pnpm test",
    "docs:rules": "tsx scripts/generate-rules-doc.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@codama/nodes-from-anchor": "1.5.6",
    "@codama/renderers-js": "2.5.0",
    "@solana/kit": "8.3.0",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.1",
    "codama": "1.11.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
