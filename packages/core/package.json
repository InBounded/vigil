{
  "name": "@vigil-sol/core",
  "version": "0.0.0",
  "description": "Read-only analysis engine for Squads v4 multisig proposals and Solana transactions: decodes, simulates and flags risks. Never signs or sends.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InBounded/vigil.git",
    "directory": "packages/core"
  },
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/test-support"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@codama/dynamic-parsers": "1.4.2",
    "@codama/nodes": "1.11.0",
    "@codama/nodes-from-anchor": "1.5.6",
    "@solana-program/address-lookup-table": "0.15.0",
    "@solana-program/compute-budget": "0.19.0",
    "@solana-program/loader-v3": "0.7.0",
    "@solana-program/memo": "0.15.0",
    "@solana-program/stake": "0.10.0",
    "@solana-program/system": "0.15.0",
    "@solana-program/token": "0.17.0",
    "@solana/kit": "8.3.0",
    "@solana/program-client-core": "8.3.0",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@solana-program/program-metadata": "0.10.0",
    "@solana-program/token-2022": "0.19.0",
    "@solana/sysvars": "8.3.0",
    "@solana/web3.js": "1.99.0",
    "@sqds/multisig": "2.1.4",
    "ajv": "8.20.0",
    "fast-check": "4.10.2"
  }
}
